
FROM python:3.14-slim

WORKDIR /mlflow

RUN pip install --no-cache-dir mlflow==3.17.2

EXPOSE 5000

CMD ["mlflow", "server", \
     "--backend-store-uri", "sqlite:////mlflow/mlflow-docker.db", \
     "--default-artifact-root", "file:///mlflow/mlruns", \
     "--host", "0.0.0.0", \
     "--port", "5000", \
     "--allowed-hosts", "mlflow,mlflow:5000,localhost,localhost:5000,127.0.0.1,127.0.0.1:5000"]
